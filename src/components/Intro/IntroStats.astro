---
interface StatItem {
    value: number;
    label: string;
}

interface Props {
    stats: StatItem[];
}

const { stats } = Astro.props;
---

<div class="mx-auto max-w-[1680px] py-12 md:py-16 xl:py-20">
    <div class="px-5 sm:px-8 md:px-10 xl:px-[70px]">
        <!-- TEXT -->
        <p
            class="mx-auto max-w-[1180px] text-center font-['Fixel'] text-[18px] font-medium leading-[1.45] text-[#2f4f52] sm:text-[20px] md:text-[22px] xl:text-[25px]"
        >
            <span class="font-['e-Ukraine'] font-bold">ПМУ</span> — це ініціативні
            підлітки, які з 2023 року займаються поширенням цінностей української
            ідентичності, висвітленням важливих для суспільства подій через соціальні
            мережі.
        </p>

        <!-- STATS -->
        <div
            class="mt-12 grid grid-cols-1 overflow-hidden rounded-[28px] bg-[#7ea4aa] text-[#2f4f52] md:mt-24 md:grid-cols-4 md:rounded-[36px]"
        >
            {
                stats.map((stat, index) => (
                    <div
                        class:list={[
                            "flex min-h-[150px] flex-col items-center justify-center px-4 py-6 md:min-h-[198px] md:py-10",
                            index < stats.length - 1 &&
                                "border-b border-white/40 md:border-b-0 md:border-r",
                        ]}
                    >
                        <span
                            class="stat-number text-[38px] font-bold leading-none md:text-[54px]"
                            data-count={stat.value}
                        >
                            0
                        </span>

                        <span class="mt-4 text-[18px] font-medium md:mt-5 md:text-[28px]">
                            {stat.label}
                        </span>
                    </div>
                ))
            }
        </div>
    </div>
</div>

<script>
    const numbers = document.querySelectorAll(".stat-number");

    const observer = new IntersectionObserver(
        (entries) => {
            entries.forEach((entry) => {
                if (!entry.isIntersecting) {
                    return;
                }

                const element = entry.target as HTMLElement;
                const target = Number(element.getAttribute("data-count"));

                let current = 0;
                const duration = 900;
                const start = performance.now();

                function animate(time: number) {
                    const progress = Math.min((time - start) / duration, 1);

                    current = Math.floor(target * progress);

                    element.textContent = String(current);

                    if (progress < 1) {
                        requestAnimationFrame(animate);
                    } else {
                        element.textContent = String(target);
                    }
                }

                requestAnimationFrame(animate);

                observer.unobserve(element);
            });
        },
        {
            threshold: 0.5,
        },
    );

    numbers.forEach((number) => observer.observe(number));
</script>
