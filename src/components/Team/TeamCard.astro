---
interface Props {
    name: string;
    role: string;
    photo: string;
}

const { name, role, photo } = Astro.props;
---

<article class="overflow-hidden rounded-[18px] bg-white">
    <div class="aspect-[410/425] bg-white">
        <img
            src={photo}
            alt={name}
            draggable="false"
            loading="lazy"
            class="h-full w-full select-none object-cover"
        />
    </div>

    <div
        class="min-h-[150px] bg-[#7ea4aa] px-6 py-5 text-[#2f4f52] xl:px-9 xl:py-7"
    >
        <h3
            class="font-['Fixel'] text-xl font-bold leading-tight xl:text-[28px]"
        >
            {name}
        </h3>

        <p class="mt-2 font-['Fixel'] text-xl leading-snug xl:text-[22px]">
            {role}
        </p>
    </div>
</article>
