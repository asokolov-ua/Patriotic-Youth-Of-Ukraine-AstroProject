---
import type { TeamMember } from "../../types/team";
import TeamCard from "./TeamCard.astro";

interface Props {
    members: TeamMember[];
}

const { members } = Astro.props;
---

<div class="team-carousel relative w-full min-w-0 flex-1 px-8 md:px-0">
    <button
        type="button"
        aria-label="Попередній учасник"
        class="team-prev absolute left-6 top-1/2 z-20 flex h-12 w-12 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border-2 border-white bg-[#7ea4aa] text-white shadow-lg transition duration-200 hover:scale-105 active:scale-95 md:left-0 md:h-14 md:w-14"
    >
        <svg viewBox="0 0 24 24" fill="none" class="h-7 w-7" aria-hidden="true">
            <path
                d="M15 18L9 12L15 6"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
        </svg>
    </button>

    <div class="team-viewport overflow-hidden py-8">
        <div class="team-container -ml-6 flex">
            {
                members.map((member) => (
                    <div class="min-w-0 shrink-0 basis-full pl-6 md:basis-1/2">
                        <TeamCard
                            name={member.name}
                            role={member.role}
                            photo={member.photo}
                        />
                    </div>
                ))
            }
        </div>
    </div>

    <button
        type="button"
        aria-label="Наступний учасник"
        class="team-next absolute right-6 top-1/2 z-20 flex h-12 w-12 translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border-2 border-white bg-[#7ea4aa] text-white shadow-lg transition duration-200 hover:scale-105 active:scale-95 md:right-0 md:h-14 md:w-14"
    >
        <svg viewBox="0 0 24 24" fill="none" class="h-7 w-7" aria-hidden="true">
            <path
                d="M9 6L15 12L9 18"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
        </svg>
    </button>
</div>

<script>
    import EmblaCarousel from "embla-carousel";

    const roots = document.querySelectorAll<HTMLElement>(".team-carousel");

    roots.forEach((root) => {
        const viewport = root.querySelector<HTMLElement>(".team-viewport");

        const previousButton =
            root.querySelector<HTMLButtonElement>(".team-prev");

        const nextButton = root.querySelector<HTMLButtonElement>(".team-next");

        if (!viewport) {
            return;
        }

        const embla = EmblaCarousel(viewport, {
            loop: true,
            align: "start",
            slidesToScroll: 1,
            dragFree: false,
            containScroll: "trimSnaps",
        });

        previousButton?.addEventListener("click", () => {
            embla.scrollPrev();
        });

        nextButton?.addEventListener("click", () => {
            embla.scrollNext();
        });
    });
</script>
