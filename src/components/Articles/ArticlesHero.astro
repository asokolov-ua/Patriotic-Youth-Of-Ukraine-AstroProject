---
import Navigation from "../Hero/Navigation.astro";
import ArticleHeroContent from "./ArticleHeroContent.astro";
---

<section class="my-4 px-4 md:px-8">
    <div
        class="relative mx-auto h-[520px] max-w-[1680px] overflow-hidden rounded-[32px] bg-[#779EA5] px-6 py-4 md:h-[650px] lg:h-[820px] lg:px-16"
    >
        <video
            autoplay
            muted
            loop
            playsinline
            class="absolute inset-0 h-full w-full object-cover"
        >
            <source src="/img/video/background.mp4" type="video/mp4" />
        </video>

        <div class="absolute inset-0 bg-black/30"></div>

        <div class="relative z-10 flex h-full flex-col">
            <Navigation />
            <ArticleHeroContent />
        </div>
    </div>
</section>
