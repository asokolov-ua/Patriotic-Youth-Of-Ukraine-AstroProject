---
interface Props {
    title: string;
    sectionName?: string;
    sectionHref?: string;
}

const {
    title,
    sectionName = "Статті",
    sectionHref = "/articles",
} = Astro.props;
---

<nav
    aria-label="Навігаційний шлях"
    class="mx-auto max-w-[1680px] px-4 pt-6 md:px-8 lg:px-16"
>
    <ol
        class="flex flex-wrap items-center gap-x-2 gap-y-1 font-['Fixel'] text-sm text-[#5f797d] md:text-base"
    >
        <li>
            <a href="/" class="transition-colors hover:text-[#2f4f52]">
                Головна
            </a>
        </li>

        <li aria-hidden="true" class="text-[#7ea4aa]">/</li>

        <li>
            <a
                href={sectionHref}
                class="transition-colors hover:text-[#2f4f52]"
            >
                {sectionName}
            </a>
        </li>

        <li aria-hidden="true" class="text-[#7ea4aa]">/</li>

        <li
            aria-current="page"
            class="max-w-[520px] truncate font-semibold text-[#2f4f52]"
            title={title}
        >
            {title}
        </li>
    </ol>
</nav>
