---
import type { EventItem } from "../../types/news";

interface Props {
    events: EventItem[];
}

const { events } = Astro.props;

const today = new Date();
today.setHours(0, 0, 0, 0);

const sortedEvents = events
    .filter((event) => new Date(event.date) >= today)
    .sort((a, b) => new Date(a.date).getTime() - new Date(b.date).getTime());
---

<aside class="xl:sticky xl:top-6 xl:self-start">
    <div
        class="rounded-[28px] bg-white p-6 shadow-[0_14px_30px_rgba(47,79,82,0.10)] md:p-8"
    >
        <p
            class="font-['Fixel'] text-sm font-semibold uppercase tracking-[0.12em] text-[#7ea4aa]"
        >
            Календар
        </p>

        <h2 class="mt-2 font-['e-Ukraine'] text-3xl font-bold text-[#2f4f52]">
            Найближчі події
        </h2>

        {
            sortedEvents.length > 0 ? (
                <div class="mt-7 divide-y divide-[#7ea4aa]/25">
                    {sortedEvents.map((event) => {
                        const date = new Date(event.date);

                        const day = new Intl.DateTimeFormat("uk-UA", {
                            day: "2-digit",
                        }).format(date);

                        const month = new Intl.DateTimeFormat("uk-UA", {
                            month: "short",
                        }).format(date);

                        const eventContent = (
                            <>
                                <div class="flex h-16 w-16 shrink-0 flex-col items-center justify-center rounded-[18px] bg-[#779ea5] text-[#2f4f52]">
                                    <span class="font-['e-Ukraine'] text-2xl font-bold leading-none">
                                        {day}
                                    </span>

                                    <span class="mt-1 font-['Fixel'] text-xs uppercase">
                                        {month}
                                    </span>
                                </div>

                                <div class="min-w-0">
                                    <h3 class="font-['e-Ukraine'] text-lg font-bold leading-tight text-[#2f4f52]">
                                        {event.title}
                                    </h3>

                                    <div class="mt-2 space-y-1 font-['Fixel'] text-sm text-[#5f797d]">
                                        {event.time && <p>{event.time}</p>}
                                        {event.location && (
                                            <p>{event.location}</p>
                                        )}
                                    </div>
                                </div>
                            </>
                        );

                        return event.href ? (
                            <a
                                href={event.href}
                                class="flex gap-4 py-5 transition-opacity hover:opacity-75"
                            >
                                {eventContent}
                            </a>
                        ) : (
                            <div class="flex gap-4 py-5">{eventContent}</div>
                        );
                    })}
                </div>
            ) : (
                <p class="mt-6 font-['Fixel'] text-[#5f797d]">
                    Найближчих подій поки немає.
                </p>
            )
        }
    </div>
</aside>
