---
import type { NewsItem } from "../../types/news";
import { getReadingTime } from "../../lib/readingTime";
import Badge from "../UI/Badge.astro";
import MetaInfo from "../UI/MetaInfo.astro";

interface Props {
    item: NewsItem;
}

const { item } = Astro.props;

const readingTime = getReadingTime(item.content);
---

<a
    href={`/news/${item.slug}`}
    class="group relative min-h-[440px] overflow-hidden rounded-[24px] bg-[#779ea5] md:min-h-[500px] md:rounded-[28px]"
>
    <img
        src={item.heroImage}
        alt={item.title}
        class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
    />

    <div
        class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/35 to-black/5"
    >
    </div>

    <div class="relative z-10 flex h-full flex-col justify-end p-6 md:p-10">
        <Badge text={item.category} />

        <h2
            class="mt-4 max-w-[850px] font-['e-Ukraine'] text-2xl font-bold leading-tight text-white sm:text-3xl md:text-5xl"
        >
            {item.title}
        </h2>

        <p
            class="mt-4 max-w-[720px] font-['Fixel'] text-base leading-relaxed text-white/85 md:max-h-0 md:overflow-hidden md:opacity-0 md:transition-all md:duration-300 md:group-hover:max-h-32 md:group-hover:opacity-100"
        >
            {item.excerpt}
        </p>

        <div class="mt-6 flex flex-wrap items-center justify-between gap-4">
            <MetaInfo date={item.date} readingTime={readingTime} />

            <span
                class="font-['Fixel'] text-sm font-semibold text-white transition-transform duration-200 group-hover:translate-x-1"
            >
                Читати →
            </span>
        </div>
    </div>
</a>
