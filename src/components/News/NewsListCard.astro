---
import type { NewsItem } from "../../types/news";
import { getReadingTime } from "../../lib/readingTime";
import Badge from "../UI/Badge.astro";
import MetaInfo from "../UI/MetaInfo.astro";

interface Props {
    item: NewsItem;
}

const { item } = Astro.props;
const readingTime = getReadingTime(item.content);
---

<article>
    <a
        href={`/news/${item.slug}`}
        class="group grid overflow-hidden rounded-[24px] bg-white shadow-[0_14px_30px_rgba(47,79,82,0.10)] transition duration-300 hover:-translate-y-1 hover:shadow-[0_20px_38px_rgba(47,79,82,0.16)] sm:grid-cols-[180px_minmax(0,1fr)] md:grid-cols-[240px_minmax(0,1fr)]"
    >
        <div class="aspect-[16/10] overflow-hidden bg-[#779ea5] sm:aspect-auto">
            <img
                src={item.cardImage}
                alt={item.title}
                loading="lazy"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
        </div>

        <div class="flex flex-col p-5 md:p-7">
            <Badge text={item.category} variant="dark" />

            <h3
                class="mt-4 font-['e-Ukraine'] text-2xl font-bold leading-tight text-[#2f4f52] md:text-3xl"
            >
                {item.title}
            </h3>

            <p
                class="mt-3 line-clamp-3 font-['Fixel'] text-sm leading-relaxed text-[#5f797d] md:text-base"
            >
                {item.excerpt}
            </p>

            <div class="mt-6 flex flex-wrap items-end justify-between gap-4">
                <MetaInfo
                    date={item.date}
                    readingTime={readingTime}
                    theme="dark"
                />

                <span
                    class="font-['Fixel'] text-sm font-semibold text-[#2f4f52] transition-transform duration-200 group-hover:translate-x-1"
                >
                    Читати →
                </span>
            </div>
        </div>
    </a>
</article>
