---
import type { NewsItem } from "../../types/news";
import { getReadingTime } from "../../lib/readingTime";
import Badge from "../UI/Badge.astro";
import MetaInfo from "../UI/MetaInfo.astro";

interface Props {
    item: NewsItem;
}

const { item } = Astro.props;

const readingTime = getReadingTime(item.content);
---

<a
    href={`/news/${item.slug}`}
    class="group relative min-h-[260px] overflow-hidden rounded-[22px] bg-[#779ea5] md:min-h-[230px] md:rounded-[24px]"
>
    <img
        src={item.cardImage}
        alt={item.title}
        loading="lazy"
        class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
    />

    <div
        class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/30 to-transparent"
    >
    </div>

    <div class="relative z-10 flex h-full flex-col justify-end p-5">
        <Badge text={item.category} />

        <h3
            class="mt-3 line-clamp-3 font-['e-Ukraine'] text-xl font-bold leading-tight text-white md:text-2xl"
        >
            {item.title}
        </h3>

        <div class="mt-3">
            <MetaInfo date={item.date} readingTime={readingTime} />
        </div>
    </div>
</a>
