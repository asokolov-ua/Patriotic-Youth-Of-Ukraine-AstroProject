---
import type { NewsItem } from "../../types/news";
import NewsListCard from "./NewsListCard.astro";

interface Props {
    items: NewsItem[];
    currentSlug: string;
    limit?: number;
}

const { items, currentSlug, limit = 3 } = Astro.props;

const relatedNews = items
    .filter((item) => item.slug !== currentSlug)
    .slice(0, limit);
---

{
    relatedNews.length > 0 && (
        <section class="px-4 py-16 md:px-8 md:py-24">
            <div class="mx-auto max-w-[1680px]">
                <div class="mb-10 flex items-end justify-between gap-6">
                    <div>
                        <p class="font-['Fixel'] text-sm font-semibold uppercase tracking-[0.12em] text-[#7ea4aa]">
                            Продовжуйте читати
                        </p>

                        <h2 class="mt-2 font-['e-Ukraine'] text-3xl font-bold text-[#2f4f52] md:text-5xl">
                            Інші новини
                        </h2>
                    </div>

                    <a
                        href="/news"
                        class="hidden font-['Fixel'] font-semibold text-[#2f4f52] transition hover:opacity-70 md:inline"
                    >
                        Усі новини →
                    </a>
                </div>

                <div class="grid gap-6 xl:grid-cols-3">
                    {relatedNews.map((item) => (
                        <NewsListCard item={item} />
                    ))}
                </div>

                <a
                    href="/news"
                    class="mt-8 inline-flex font-['Fixel'] font-semibold text-[#2f4f52] md:hidden"
                >
                    Усі новини →
                </a>
            </div>
        </section>
    )
}
